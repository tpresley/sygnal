import { describe, it, expect, afterEach } from 'vitest'
import { renderComponent } from 'sygnal'
import App from './App.jsx'

// renderComponent runs App without a browser. `strict: true` also reports
// non-canonical forms; expectNoDiagnostics() fails the test on any warning.
let t
afterEach(() => t?.dispose())

describe('App', () => {
  it('adds a task', async () => {
    t = renderComponent(App, { strict: true })
    t.simulateEvent('.add-input', 'input', { value: 'Write a test' })
    await t.waitForState(s => s.inputValue === 'Write a test')
    t.simulateEvent('.add-btn', 'click')

    const state = await t.waitForState(s => s.tasks.length === 4)
    expect(state.tasks[3]).toEqual({ id: 4, text: 'Write a test', done: false })
    expect(state.inputValue).toBe('')
    t.expectNoDiagnostics()
  })

  it('toggles and deletes tasks from the TaskItem children', async () => {
    t = renderComponent(App, { strict: true })
    t.simulateEvent('.toggle', 'click') // the first task
    await t.waitForState(s => s.tasks[0].done === false)

    t.simulateEvent('.delete', 'click')
    const state = await t.waitForState(s => s.tasks.length === 2)
    expect(state.tasks).toMatchObject([{ id: 2 }, { id: 3 }])
    t.expectNoDiagnostics()
  })
})
