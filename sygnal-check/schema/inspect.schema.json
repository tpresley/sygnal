{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sygnal.js.org/schema/inspect.schema.json",
  "title": "Sygnal app graph (inspect)",
  "description": "The machine-readable structure of a Sygnal app, produced at runtime (inspect() / getDevTools().inspect() / renderComponent's t.inspect() from the 'sygnal/diagnostics' dev entry) and statically (sygnal-check --graph --json). Fields one side cannot know are null or omitted. TypeScript: InspectGraph in sygnal/diagnostics.",
  "type": "object",
  "required": ["version", "components", "events", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "source": { "enum": ["runtime", "static"] },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "events": {
      "description": "EVENTS bus: type -> names of the components that emit / select it",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["emitters", "selectors"],
        "additionalProperties": false,
        "properties": {
          "emitters": { "$ref": "#/$defs/strings" },
          "selectors": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "diagnostics": {
      "description": "Diagnostics not tied to a listed component",
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "recentActions": {
      "description": "runtime only, with inspect({ actions }): the most recent actions of any instance, oldest first",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "component", "instance", "sinks", "cause", "at"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "data": {},
          "component": { "type": "string" },
          "instance": { "type": "string" },
          "sinks": { "$ref": "#/$defs/strings" },
          "cause": { "enum": ["intent", "next", "reply", "built-in", "simulateAction", "behavior"] },
          "at": { "type": "number" }
        }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "component": {
      "type": "object",
      "required": [
        "name", "id", "parentId", "kind", "actions", "stateKeys", "calculated", "contextProvides",
        "eventsEmitted", "eventsSelected", "children", "selectors", "diagnostics"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string", "description": "runtime: instance number; static: 'file:line' of the definition" },
        "parentId": { "type": ["string", "null"], "description": "runtime: parent instance id; static: null" },
        "file": { "type": "string", "description": "static only: source file relative to the working directory" },
        "kind": { "enum": ["root", "child", "collection-item", "switchable"] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "stateKeys": { "$ref": "#/$defs/strings" },
        "calculated": { "$ref": "#/$defs/strings" },
        "contextProvides": { "$ref": "#/$defs/strings" },
        "contextConsumes": {
          "description": "context fields read in the view (static); null at runtime",
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "eventsEmitted": { "$ref": "#/$defs/strings" },
        "eventsSelected": { "$ref": "#/$defs/strings" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/child" } },
        "selectors": { "type": "array", "items": { "$ref": "#/$defs/selector" } },
        "uses": {
          "description": "static: the entries of the component's `uses` static (behaviors); omitted when it has none",
          "type": "array",
          "items": { "$ref": "#/$defs/uses" }
        },
        "controls": {
          "description": "controls (controls() element tokens) the component renders; omitted when there are none",
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        },
        "commands": {
          "description": "static: the element commands (ELEMENT sink) its model sends; omitted when there are none",
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "timers": {
          "description": "static: the literal timer specs of its `timers` static; omitted when there are none",
          "type": "array",
          "items": { "$ref": "#/$defs/timer" }
        },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "command": {
      "type": "object",
      "required": ["action", "method", "target"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "description": "the model entry that sends it" },
        "method": { "type": "string", "description": "the command's method (its first key)" },
        "target": { "type": ["string", "null"], "description": "the control's key or the selector; null when not static" },
        "control": { "type": "string", "description": "the control it targets (its key)" },
        "triggers": { "$ref": "#/$defs/strings", "description": "intent actions listening on the target for a native event the command causes (close, toggle...)" }
      }
    },
    "timer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "every": { "type": ["number", "null"] },
        "after": { "type": ["number", "null"] },
        "frame": { "type": ["string", "null"], "description": "the action a frame timer dispatches" },
        "action": { "type": ["string", "null"] },
        "background": { "const": true }
      }
    },
    "action": {
      "type": "object",
      "required": ["name", "trigger", "sinks"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "trigger": { "enum": ["intent", "next", "reply", "builtin", "unknown"] },
        "sinks": { "$ref": "#/$defs/strings" },
        "behavior": { "type": "string", "description": "the `uses` key of the behavior that owns this action ('pager' for 'pager.NEXT')" }
      }
    },
    "uses": {
      "type": "object",
      "required": ["key", "behavior", "status"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "description": "the state key and action prefix" },
        "behavior": { "type": ["string", "null"], "description": "the behavior's name (its factory), when resolved" },
        "status": { "enum": ["resolved", "opaque", "invalid"], "description": "resolved to a defineBehavior() definition or a first-party behavior; opaque (e.g. from a package); invalid (not a behavior, SYG127)" }
      }
    },
    "child": {
      "type": "object",
      "required": ["name", "via"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "via": { "enum": ["tag", "collection", "switchable", "slot"] },
        "from": { "type": ["string", "null"], "description": "Collection: the state field it renders, when known" },
        "count": { "type": "integer", "description": "runtime: live instances behind this entry" }
      }
    },
    "selector": {
      "type": "object",
      "required": ["selector", "events", "matched", "isolationHit"],
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string" },
        "events": { "type": ["array", "null"], "items": { "type": "string" } },
        "matched": { "type": ["boolean", "null"], "description": "matches an element the component itself renders (static: in the view source; renderComponent: in the latest render; real DOM: seen by the DOM checks); null when unknown" },
        "isolationHit": { "type": ["string", "null"], "description": "child component whose isolated elements the selector matches instead" },
        "control": { "type": "string", "description": "the control this selector is (its key), when the intent passed a control" },
        "behavior": { "type": "string", "description": "the `uses` key of the behavior that listens to it (a control or selector passed as its option)" }
      }
    },
    "control": {
      "type": "object",
      "required": ["name", "element", "listened"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "the control's key (rendered as data-control=\"<name>\")" },
        "element": { "type": ["string", "null"], "description": "the intrinsic tag for a tag spec; null for a spec object" },
        "kind": { "type": "string", "description": "a spec object's kind (e.g. 'widget')" },
        "listened": { "type": ["boolean", "null"], "description": "the component's intent listens to it; null when unknown" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["error", "warn", "info"] },
        "component": { "type": "string" },
        "message": { "type": "string" },
        "fix": { "type": "string" },
        "docsUrl": { "type": "string" },
        "data": {},
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "column": { "type": "integer" }
      }
    }
  }
}
