{
  "description": "E8: branch + sygnal-check installed and its MCP server (check / graph / explain) configured for Sygnal-arm agents",
  "sygnal": "branch",
  "skill": { "dir": "skills/sygnal-dev" },
  "overlay": {
    "sygnal": {
      "packs": { "sygnal-check": { "dir": "sygnal-check", "dependency": "devDependencies" } }
