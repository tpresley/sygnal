{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "sygnal",
    "baseUrl": ".",
    "paths": {
      "sygnal": ["../src/index.d.ts"],
      "sygnal/jsx-runtime": ["../src/jsx-runtime.d.ts"],
      "sygnal/devtools": ["../src/devtools.d.ts"],
      "sygnal/element": ["../src/element.d.ts"],
      "sygnal/ui": ["../src/ui.d.ts"],
      "sygnal/ui/menu": ["../src/ui-menu.d.ts"],
      "sygnal/ui/select": ["../src/ui-select.d.ts"],
      "sygnal/ui/combobox": ["../src/ui-combobox.d.ts"],
      "sygnal/zag": ["../src/zag.d.ts"],
      "sygnal/ai": ["../src/ai.d.ts"],
      "sygnal/react": ["../src/react.d.ts"],
      "sygnal/ai": ["../src/ai.d.ts"],
      "sygnal/astro": ["../src/astro/index.d.ts"],
      "xstream": ["../node_modules/xstream"],
      "xstream/*": ["../node_modules/xstream/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["./registry/**"]
}
