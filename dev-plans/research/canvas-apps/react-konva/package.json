{
  "name": "canvas-react-konva-baseline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Figma-lite baseline in idiomatic React 19 + react-konva, for the sygnal/canvas comparison",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf": "vite build && node perf/run.mjs",
    "perf:check": "node --check perf/run.mjs && node perf/run.mjs --help",
    "lines": "node scripts/count-lines.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.24",
    "konva": "10.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
