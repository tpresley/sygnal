{
  "name": "sygnal",
  "version": "5.4.0",
  "description": "An intuitive framework for building fast and small components or applications based on Cycle.js",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./jsx": {
      "types": "./src/jsx.d.ts",
      "import": "./dist/jsx.esm.js",
      "require": "./dist/jsx.cjs.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.esm.js",
      "require": "./dist/jsx-runtime.cjs.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.esm.js",
      "require": "./dist/jsx-dev-runtime.cjs.js"
    },
    "./diagnostics": {
      "types": "./src/extra/diagnostics/checks/public.d.ts",
      "import": "./dist/diagnostics.esm.js",
      "require": "./dist/diagnostics.cjs.js"
    },
    "./devtools": {
      "types": "./src/devtools.d.ts",
      "import": "./dist/devtools.esm.js",
      "require": "./dist/devtools.cjs.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "import": "./dist/element.esm.js",
      "require": "./dist/element.cjs.js"
    },
    "./shims/globalthis": "./dist/shims/globalthis.cjs",
    "./vite": {
      "types": "./src/vite/plugin.d.ts",
      "import": "./dist/vite/plugin.mjs",
      "require": "./dist/vite/plugin.cjs.js"
    },
    "./astro": {
      "types": "./src/astro/index.d.ts",
      "import": "./dist/astro/index.mjs",
      "require": "./dist/astro/index.cjs.js"
    },
    "./astro/client": {
      "types": "./src/astro/client.d.ts",
      "import": "./dist/astro/client.mjs",
      "require": "./dist/astro/client.cjs.js"
    },
    "./astro/server": {
      "types": "./src/astro/server.d.ts",
      "import": "./dist/astro/server.mjs",
      "require": "./dist/astro/server.cjs.js"
    },
    "./vike": {
      "types": "./src/vike/types.ts",
      "default": "./dist/vike/config/+config.js"
    },
    "./vike/config": {
      "types": "./src/vike/types.ts",
      "default": "./dist/vike/config/+config.js"
    },
    "./config": {
      "types": "./src/vike/types.ts",
      "default": "./dist/vike/config/+config.js"
    },
    "./vike/onRenderHtml": {
      "import": "./dist/vike/onRenderHtml.mjs",
      "require": "./dist/vike/onRenderHtml.cjs.js"
    },
    "./vike/onRenderClient": {
      "import": "./dist/vike/onRenderClient.mjs",
      "require": "./dist/vike/onRenderClient.cjs.js"
    },
    "./vike/ClientOnly": {
      "import": "./dist/vike/ClientOnly.mjs",
      "require": "./dist/vike/ClientOnly.cjs.js"
    },
    "./types": {
      "import": "./dist/index.d.ts",
      "require": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run && npm run test:examples && npm run test:types && npm run test:browser && npm run test:perf-gate",
    "test:perf-gate": "node scripts/perf-gate.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "test:types": "npx tsc --project tsconfig.json --noEmit && npx tsc --project type-tests/tsconfig.json",
    "test:browser": "npm test --prefix browser-tests",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npx rollup -c && npx rollup -c rollup.config.dts.mjs && node scripts/copy-guides.mjs",
    "build:types": "npx rollup -c rollup.config.dts.mjs",
    "build:all": "npm run build",
    "build:devtools": "node devtools/build.mjs",
    "start": "npx rollup -c -w",
    "prepublishOnly": "npm run build:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpresley/sygnal.git"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "keywords": [
    "cycle",
    "cyclejs",
    "component",
    "functional reactive",
    "SPA"
  ],
  "author": "Troy Presley <troy.presley@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tpresley/sygnal/issues"
  },
  "homepage": "https://github.com/tpresley/sygnal#readme",
  "dependencies": {
    "snabbdom": "^3.6.3",
    "xstream": "^11.14.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-terser": "^0.4.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "flatpickr": "4.6.13",
    "jsdom": "^29.1.1",
    "rollup": "^3.28.1",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "^7.3.6"
  }
}
