{
  "name": "sygnal",
  "version": "7.2.0-preview.0",
  "description": "An intuitive framework for building fast and small components or applications based on Cycle.js",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.esm.js",
  "sideEffects": [
    "./dist/index.esm.js",
    "./dist/index.cjs.js",
    "./dist/diagnostics.esm.js",
    "./dist/diagnostics.cjs.js",
    "./dist/devtools.esm.js",
    "./dist/devtools.cjs.js",
    "./dist/shims/globalthis.cjs",
    "./dist/sandbox-worker.esm.js",
    "./dist/sandbox-worker.cjs.js",
    "./dist/sandbox-kernel.esm.js",
    "./dist/sygnal.min.js"
  ],
