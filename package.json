      "types": "./src/sandbox-build.d.ts",
      "import": "./dist/sandbox-build.esm.js",
      "require": "./dist/sandbox-build.cjs.js"
    },
    "./sandbox/worker": {
      "import": "./dist/sandbox-worker.esm.js",
      "require": "./dist/sandbox-worker.cjs.js"
    },
    "./sandbox/kernel-entry": {
      "import": "./dist/sandbox-kernel.esm.js"
    },
    "./shims/globalthis": "./dist/shims/globalthis.cjs",
    "./vite": {
      "types": "./src/vite/plugin.d.ts",
      "import": "./dist/vite/plugin.mjs",
      "require": "./dist/vite/plugin.cjs.js"
    },
    "./astro": {
      "types": "./src/astro/index.d.ts",
